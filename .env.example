# Copie para .env e preencha. Nunca faça commit do .env.

# --- Servidor (bot + painel) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Endereço público do bot (usado para montar a URL do webhook)
PUBLIC_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Sao_Paulo

# --- Banco de dados ---
# Em desenvolvimento: Supabase > Project Settings > Database > Connection string
# > "Session pooler" (funciona em rede só IPv4). Troque [YOUR-PASSWORD].
# No VPS o docker-compose sobrescreve este valor com o Postgres do próprio compose.
DATABASE_URL=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- WhatsApp ---
# evolution (demo/prospecção) ou meta_cloud (API oficial, cliente fechado)
WHATSAPP_PROVIDER=evolution
# Segredo que a Evolution/Meta manda no webhook para provar que é ela
WEBHOOK_SECRET=

# Evolution API (self-hosted). No compose, EVOLUTION_API_URL vira http://evolution:8080
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution. Gere uma longa e aleatória.
EVOLUTION_API_KEY=
EVOLUTION_PUBLIC_URL=http://localhost:8080

# WhatsApp Cloud API (Meta) — preencher quando migrar um cliente
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Só para o docker-compose (VPS) ---
POSTGRES_USER=chamalia
POSTGRES_PASSWORD=
