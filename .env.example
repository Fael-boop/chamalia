# Copie para .env e preencha. Nunca faça commit do .env.

# --- Servidor (bot + painel) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Endereço público do bot (usado para montar a URL do webhook)
PUBLIC_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Sao_Paulo

# Senha do painel. Em desenvolvimento pode ficar vazia (painel aberto).
# Em produção é obrigatória (mínimo 12 caracteres).
ADMIN_PASSWORD=
# Assina os logins do painel (mínimo 32 caracteres; obrigatória em produção). Trocar desconecta todo mundo.
SESSION_SECRET=

# --- Mercado Pago (Pix das assinaturas confirmado sozinho) ---
# Access Token de produção (Suas integrações > aplicação > Credenciais de produção). Sem ele, vale o Pix
# configurado em Planos, com confirmação manual.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: assinatura secreta dos webhooks da aplicação.
MERCADOPAGO_WEBHOOK_SECRET=
# Public Key (credenciais de produção): liga o débito automático no cartão. Sem ela, só Pix.
MERCADOPAGO_PUBLIC_KEY=

# --- Banco de dados ---
# Em desenvolvimento: Supabase > Project Settings > Database > Connection string
# > "Session pooler" (funciona em rede só IPv4). Troque [YOUR-PASSWORD].
# No VPS o docker-compose sobrescreve este valor com o Postgres do próprio compose.
DATABASE_URL=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Transcrição de áudios do WhatsApp (Groq, Whisper). Chave em console.groq.com. Vazio = a Lia pede para escrever.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- WhatsApp ---
# evolution (demo/prospecção) ou meta_cloud (API oficial, cliente fechado)
WHATSAPP_PROVIDER=evolution
# Segredo que a Evolution/Meta manda no webhook para provar que é ela
WEBHOOK_SECRET=

# Evolution API (self-hosted). No compose, EVOLUTION_API_URL vira http://evolution:8080
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution. Gere uma longa e aleatória.
EVOLUTION_API_KEY=
EVOLUTION_PUBLIC_URL=http://localhost:8080
# Endereço do bot visto de dentro do container da Evolution (dev: host.docker.internal)
EVOLUTION_WEBHOOK_BASE_URL=http://host.docker.internal:3000

# WhatsApp Cloud API (Meta) — preencher quando migrar um cliente
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Só para o docker-compose (VPS) ---
POSTGRES_USER=chamalia
POSTGRES_PASSWORD=
