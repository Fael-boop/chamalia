{
  "name": "@chamalia/server",
  "version": "1.6.5",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "whatsapp:connect": "tsx --env-file-if-exists=../../.env src/scripts/whatsapp-connect.ts",
    "db:seed:salon": "tsx --env-file-if-exists=../../.env src/db/seed-salon.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
