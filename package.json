{
  "name": "chamalia",
  "version": "1.4.0",
  "private": true,
  "description": "ChamaLia: atendente virtual no WhatsApp para clínicas, estética e barbearias",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "version:bump": "npm version --workspaces --include-workspace-root --no-git-tag-version",
    "dev:server": "npm run dev -w @chamalia/server",
    "dev:panel": "npm run dev -w @chamalia/panel",
    "db:migrate": "npm run db:migrate -w @chamalia/server",
    "db:seed": "npm run db:seed -w @chamalia/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "whatsapp:connect": "npm run whatsapp:connect -w @chamalia/server --",
    "evolution:up": "docker compose -f docker-compose.dev.yml --env-file .env up -d",
    "evolution:down": "docker compose -f docker-compose.dev.yml --env-file .env down",
    "db:seed:salon": "npm run db:seed:salon -w @chamalia/server",
    "dev:site": "npm run dev -w @chamalia/site"
  }
}
